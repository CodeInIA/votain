# Votain tally script — environment
# Copy to .env and fill in

# Amoy RPC endpoint
RPC_URL=https://rpc-amoy.polygon.technology

# Path to the Paillier keypair JSON exported by the organizer from the browser
# (localStorage key: votain_paillier_sk_<electionAddress>)
PAILLIER_KEY_FILE=paillier-key.json

# Only required with --publish: EOA that owns the election (the organizer)
ORGANIZER_PRIVATE_KEY=

# Only required with --pin: Pinata API JWT (free tier)
PINATA_JWT=
