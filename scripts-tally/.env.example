# Votain tally script: environment
# Copy to .env and fill in

# Amoy RPC endpoint.
# NOTE: https://rpc-amoy.polygon.technology no longer resolves (dead since 2026).
# The tally scans VoteCast over the full block range, so it needs an endpoint
# without a getLogs range cap. Tenderly works; drpc and publicnode cap at 10000.
RPC_URL=https://polygon-amoy.gateway.tenderly.co

# Block to start scanning VoteCast from. Use `deployedAtBlock` from
# contracts/deployments/amoy.json: it makes the scan orders of magnitude
# cheaper and keeps it inside the range caps of the limited endpoints.
FROM_BLOCK=

# Path to the Paillier keypair JSON exported by the organizer from the browser
# (localStorage key: votain_paillier_sk_<electionAddress>)
PAILLIER_KEY_FILE=paillier-key.json

# Only required with --publish: EOA that owns the election (the organizer)
ORGANIZER_PRIVATE_KEY=

# Only required with --pin: Pinata API JWT (free tier)
PINATA_JWT=
