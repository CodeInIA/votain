# Votain circuits: publishing a deployment's proving files
# Copy to .env. Only `npm run publish:circuits -- <network>` reads it; building
# and testing the circuits need none of this.

# A 4EVERLAND bucket (Storage -> Bucket), PUBLIC, and a key for it (Bucket ->
# Access Keys). The script uploads through its S3-compatible API.
FOUREVERLAND_BUCKET=
FOUREVERLAND_ACCESS_KEY=
FOUREVERLAND_SECRET_KEY=

# The bucket's public address, as the dashboard shows it for any file, without
# the file's path. Default: https://<bucket>.4everbucket.com
CIRCUITS_BASE_URL=

# Read-only RPC used to check the keys against the deployed verifiers.
# Default for amoy: publicnode.
RPC_URL=
