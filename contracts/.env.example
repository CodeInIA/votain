# Votain contracts: environment variables
# Copy this file to .env and fill in the real values
# NEVER commit .env with real values

# ── Network ──
# NOTE: https://rpc-amoy.polygon.technology no longer resolves (dead since 2026).
# Working free endpoints: polygon-amoy.drpc.org, polygon-amoy-bor-rpc.publicnode.com,
# polygon-amoy.gateway.tenderly.co
AMOY_RPC_URL=https://polygon-amoy.drpc.org

# Deployer key. Becomes the PlatformRegistry owner, so the backend
# REGISTRAR_PRIVATE_KEY must be this same key.
# Budget: run `npx hardhat run scripts/estimate-deploy-cost.ts` for a live figure.
PRIVATE_KEY=

# ── ERC-2771 trusted forwarder ──
# ZeroDev is ERC-4337, not ERC-2771, so there is no forwarder to point at here.
# Use a burn address to keep _msgSender() == msg.sender. Leaving it unset makes
# deploy.ts fall back to the deployer address, which grants that key the ability
# to impersonate organizers.
TRUSTED_FORWARDER=0x000000000000000000000000000000000000dEaD

# ── PolygonScan verification ──
# Free key from https://etherscan.io/apis. The Etherscan V2 unified API means one
# key covers Polygon Amoy (chainid 80002); the old PolygonScan key is gone.
ETHERSCAN_API_KEY=

# ── Optional ──
# Set to true to use SemaphoreVerifierV4 instead of MockVerifier on a local net.
# USE_REAL_VERIFIER=true

# ── Optional, estimate-deploy-cost.ts ──
# Where to read the live gas price and check whether PoseidonT3 already exists.
# Defaults to AMOY_RPC_URL, then to a public endpoint.
# ESTIMATE_RPC_URL=
# Pins the gas price instead of reading it from the chain, for what-if runs.
# GAS_PRICE_GWEI=
