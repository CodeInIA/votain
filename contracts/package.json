{
  "name": "contracts",
  "version": "1.0.0",
  "description": "Smart Contracts for Votain E2E Voting System",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "hardhat test",
    "build": "hardhat compile",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy --build-profile production",
