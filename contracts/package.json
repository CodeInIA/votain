{
  "name": "contracts",
  "version": "1.0.0",
  "description": "Smart Contracts for Votain E2E Voting System",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "test": "hardhat test",
    "build": "hardhat compile",
    "typecheck": "tsc --noEmit",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy --build-profile production",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "estimate:amoy": "hardhat run scripts/estimate-deploy-cost.ts --build-profile production",
    "node:local": "hardhat node",
    "tunnel:local": "cloudflared tunnel run --url http://127.0.0.1:8545 votain-local",
    "seed:local": "hardhat run scripts/seed-demo.ts --network localhost"
  },
  "keywords": [
    "voting",
    "smart-contracts",
    "hardhat"
  ],
  "author": "Sergio Barrios Paz",
  "license": "AGPL-3.0-only",
  "type": "module",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@semaphore-protocol/group": "^4.14.3",
    "@semaphore-protocol/identity": "^4.14.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.2",
    "@zk-kit/lean-imt": "^2.2.5",
    "hardhat": "^3.17.0",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "^0.7.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@zk-kit/lean-imt.sol": "^2.0.1",
    "dotenv": "^18.0.2",
    "poseidon-solidity": "^0.0.5"
  }
}
