# Votain Backend Issuer: Environment variables
# Copy this file to .env and fill in the real values
# NEVER commit .env with real values

# Ed25519 private key for the issuer (PKCS8, base64)
# Generate with:
#   node -e "const {generateKeyPairSync}=require('crypto'); const {privateKey}=generateKeyPairSync('ed25519',{privateKeyEncoding:{type:'pkcs8',format:'der'}}); console.log(privateKey.toString('base64'))"
ISSUER_PRIVATE_KEY=

# World ID Developer Portal: https://developer.worldcoin.org/
# READ BY THE BACKEND, and it was not always. The proof request is opened here
# now rather than in the browser, so that a verification survives the phone
# discarding the tab its owner left to go and approve it. The frontend no
# longer reads a copy of this: it asks /api/worldid/request instead.
WORLD_ID_APP_ID=app_staging_xxxxxxxxxxxxxxxxxxxxx
DEVELOPER_KEY=

# RP ID used in /verify-human to call the World ID verification API
# Shown in the Developer Portal as "App ID": same value as WORLD_ID_APP_ID in staging
WORLD_ID_RP_ID=app_staging_xxxxxxxxxxxxxxxxxxxxx

# Action name registered in the World ID Developer Portal
# Must match exactly the action configured in the portal
WORLD_ID_ACTION=vote-registration

# Cross-origin access, OFF unless one of these names somebody.
#
# The app does not need it: the browser calls /api/... on its own origin, in
# development through the HTTPS tunnel and in production on the same domain.
# Set CORS_ORIGINS (comma separated, no trailing slash) only for a deployment
# that really does serve the frontend from another origin. FRONTEND_URL is read
# as a fallback for the same purpose.
# CORS_ORIGINS=https://votain.example
# ALSO GATES THE MOBILE RETURN LINKS, and in production it must be set. Both
# Self's callback and World ID's `return_to` are destinations another app
# navigates to on Votain's behalf, so `sanitiseCallbackUrl` refuses any origin
# that is not this one. Left empty in production, both are dropped and the
# voter is simply not offered a way back. Development stays permissive,
# because the dev server is reached over a LAN address or a tunnel that no
# configuration knows in advance.
FRONTEND_URL=

# Set to 1 ONLY when serving over plain HTTP, which drops both the Secure flag
# and the __Host- prefix from the session cookie. Development over the tunnel is
# HTTPS and wants the default.
# COOKIE_INSECURE=1

# Environment (development | production)
NODE_ENV=development

# Server port
PORT=3000

# How many proxies sit in front of this server, for `req.ip` and therefore
# for every rate limit. Default "loopback": trust a proxy on this machine
# (the dev tunnel) and nothing else. Use a NUMBER behind real proxies, or
# "false" when the server is reached directly. Never "true" on the open
# internet: it trusts an address the client writes, which makes the limits
# trivial to walk past.
TRUST_PROXY=loopback

# Public base URL of this backend (used in credentialStatus URLs). Defaults to
# http://localhost:$PORT when unset.
PUBLIC_URL=http://localhost:3000

# Issuer DID / identifier embedded as the VC `iss` claim
ISSUER_DID=https://issuer.votain.local

# ── On-chain registrar ──
# After World ID verification the issuer registers the voter's Semaphore
# identity commitment in PlatformRegistry. The registrar wallet MUST be the
# PlatformRegistry owner (the contracts deployer). REQUIRED: this key writes both
# the registration and the encrypted identity vault, which live in the registry.
# With it unset the vault routes answer 503 and no voter can be registered.
# NOTE: https://rpc-amoy.polygon.technology no longer resolves (dead since 2026).
# The registrar only writes, so any working endpoint is fine.
CHAIN_RPC_URL=https://polygon-amoy.drpc.org
# OVERRIDE ONLY. Left empty, the address comes from the deployment manifest
# (contracts/deployments/<network>.json), which is what the frontend already
# reads, so a redeploy updates both at once. Copying it here by hand is what
# used to leave this backend calling a contract that was no longer there.
# Set it when there is no manifest beside the backend, which is the production
# case, and set CHAIN_NETWORK when several manifests exist.
REGISTRY_ADDRESS=
REGISTRAR_PRIVATE_KEY=

# Which deployment manifest to read addresses from, by network name ("local",
# "amoy"). Only needed when more than one exists: with a single manifest it is
# unambiguous, and rather than guess between several the resolver falls back to
# the addresses above and says so in the log.
CHAIN_NETWORK=

# ── Relayer ──
# Submits voters' enroll/castVote through ElectionPaymaster, which reimburses the
# gas from the organizer's tank in the same transaction. This wallet only fronts a
# small float. It needs NO special on-chain permission: both relayed calls are
# gated by the contracts (registry membership / ZK proof), so a compromised
# relayer can delay a vote but never forge one.
# Can be the same key as REGISTRAR_PRIVATE_KEY, but a separate one is cleaner.
# OVERRIDE ONLY, like REGISTRY_ADDRESS above.
PAYMASTER_ADDRESS=
RELAYER_PRIVATE_KEY=

# ── Attribute eligibility (age, nationality) ──
# An election may restrict enrollment to voters who prove attributes from their
# passport chip. The proof is checked here, off chain, because a contract cannot
# verify one: it is anchored on another network. What the contract CAN check is a
# signature, so this key signs an EIP-712 attestation that one commitment may
# enroll, and the election is deployed naming its address.
#
# This key cannot vote, cannot read a ballot, cannot enroll anyone twice (the
# contract still deduplicates by human) and cannot touch an election that did not
# name it. Losing it compromises no tally; it only stops new enrollments into
# elections that already named it.
ELIGIBILITY_ATTESTER_PRIVATE_KEY=

# The keys that turn a human into a per-election enrolment tag, one per epoch,
# as JSON: {"YYYY-MM":"<64 hex chars>", ...}. The epoch is the UTC month the
# election was DEPLOYED in, read from the contract's immutable `createdAt`.
#
# SEPARATE FROM THE SIGNING KEY ABOVE, and it used to be derived from it. The
# two risks are nothing alike: a leaked signing key forges enrolments from that
# moment and you rotate it, while a leaked tag key reconstructs who joined what
# across every election ever held, retroactively, and rotating repairs nothing.
# Welded, rotating the signer after a compromise changed every tag and handed a
# second leaf to anybody mid-enrolment.
#
# RETIRING ONE IS HOW THIS FORGETS. An election created in epoch E only enrols
# while its own window is open, and afterwards nothing recomputes its tags. Once
# every election created in E has closed enrolment, delete E's key: those
# enrolments are then beyond reach of everyone, this platform included.
#
# Adding the current month before deploying is required. A missing epoch makes
# the server REFUSE to issue a tag rather than substitute another key, because
# substituting would issue a second tag for an election that already has one on
# chain, which is the double-vote this whole scheme prevents.
#
# Mint one with:  node --import tsx scripts/mint-tag-key.ts
ENROLMENT_TAG_KEYS=

# Public HTTPS URL of the eligibility verify route. The Self relayer POSTs the
# voter's proof here, so it MUST be reachable from the internet: localhost is
# rejected by the SDK. In development use a tunnel (ngrok or similar) and put
# the tunnel URL here.
SELF_ENDPOINT=https://your-tunnel.example.com/api/eligibility/verify

# "1" accepts mock passports generated inside the Self app (five taps on the
# "Passport" button opens an editor for nationality, age and OFAC status). Test
# and live documents are cryptographically distinct, so a mock can never pass a
# live flow by accident. Leave unset in production.
SELF_MOCK=1

# ── Admin ──
# Bearer token protecting the credential revocation endpoint
ADMIN_TOKEN=

# ── Demo selective-disclosure attributes ──
# Placeholder identity attributes issued until World ID Credentials selective
# disclosure (passport NFC) is wired. See docs/dev/architecture.md.
DEMO_VC_COUNTRY=ES
DEMO_VC_REGION=Madrid

