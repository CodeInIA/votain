{
  "name": "votain-issuer-backend",
  "version": "1.0.0",
  "description": "The VC Issuer backend for emitting Verifiable Credentials (SD-JWT) mediated by World ID proofs (Phase 2).",
  "main": "index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch --include .env src/index.ts",
    "build": "tsc",
    "test": "node --import tsx --test src/**/*.test.ts",
    "e2e:vault": "tsx scripts/e2e-vault.ts"
  },
  "keywords": [
    "world-id",
    "semaphore",
    "zero-knowledge",
    "sd-jwt",
    "voting"
  ],
  "author": "Sergio Barrios Paz",
  "license": "AGPL-3.0-only",
  "type": "module",
  "dependencies": {
    "@sd-jwt/core": "^0.20.0",
    "@selfxyz/common": "^0.0.10",
    "@selfxyz/core": "^1.2.0-beta.2",
    "@worldcoin/idkit-core": "^4.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
