# Production build values. Loaded by `vite build` only (mode=production), and
# it wins over .env, so local development keeps whatever that file says.
#
# Committed on purpose: nothing here is a secret, and a build that has to be
# told its own address on the command line is a build that will one day ship a
# sitemap full of localhost.

# The origin the dApp is served from. Fills the canonical link, the Open Graph
# URLs and the manifest references in index.html, and is what robots.txt and
# sitemap.xml are generated from (src/seo/seoPlugin.ts).
VITE_PUBLIC_URL=https://votain.app

# WalletConnect project id. Public by design: it identifies the project to the
# relay and ships inside the client bundle of every dApp that uses it. It
# authorises nothing and cannot be used to sign.
VITE_WALLETCONNECT_PROJECT_ID=23d11eed30e6db26b90758ef82f9e616
