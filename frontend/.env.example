# Votain Frontend: Environment variables
# Copy to .env for local development

# Backend issuer URL
VITE_BACKEND_URL=http://localhost:3000

# World ID App ID from the Developer Portal
VITE_WORLD_ID_APP_ID=app_staging_xxxxxxxxxxxxxxxxxxxxx

# RP ID for IDKit (same value as App ID in staging)
VITE_WORLD_ID_RP_ID=app_staging_xxxxxxxxxxxxxxxxxxxxx

# Action name registered in the Developer Portal (must match backend WORLD_ID_ACTION)
VITE_WORLD_ID_ACTION=vote-registration

# Polygon Amoy RPC URL.
# NOTE: https://rpc-amoy.polygon.technology no longer resolves (dead since 2026).
# Use Tenderly: it is the only free Amoy endpoint that serves eth_getLogs over the
# full block range. The client calls queryFilter without a fromBlock (members,
# vote history, tally); drpc and publicnode cap getLogs at 10000 blocks and would
# silently truncate those lists.
# VITE_RPC_URL is the generic override and wins over VITE_AMOY_RPC_URL.
VITE_RPC_URL=https://polygon-amoy.gateway.tenderly.co
VITE_AMOY_RPC_URL=https://polygon-amoy.gateway.tenderly.co

# Target network name (matches the deployment manifest filename). Default: amoy
VITE_CHAIN_NETWORK=amoy
VITE_CHAIN_ID=80002

# ── Gasless voting ──
# Voters never send their own transaction: a per-voter address would link their
# enroll to their ballot on chain. They post to the issuer's relayer instead
# (VITE_BACKEND_URL), which forwards through ElectionPaymaster. Nothing to
# configure here.

# Deployed contract addresses on Amoy.
# NOTE: the deploy script also writes src/lib/deployments/amoy.json, which the
# client reads automatically: these env vars are only needed to override it.
VITE_ELECTION_FACTORY_ADDRESS=
VITE_PLATFORM_REGISTRY_ADDRESS=
VITE_PAYMASTER_ADDRESS=
