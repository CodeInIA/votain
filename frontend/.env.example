# Votain Frontend: Environment variables
# Copy to .env for local development

# Backend issuer URL. LEAVE IT BLANK to use this app's own origin, which the dev
# server proxies to the local backend. That is what testing on a phone needs: a
# tunnelled page is https and may not call an http backend, the session cookie is
# SameSite=strict so two tunnels are two sites, and a blank value names no
# hostname, so nothing here has to be edited when the tunnel restarts.
VITE_BACKEND_URL=http://localhost:3000

# NO WORLD ID CONFIGURATION HERE ANY MORE, and that is not an omission.
# The proof request is opened by the backend now, so that a verification
# survives the phone discarding the tab its owner left to go and approve it in
# World App. The app id, the RP id and the action live in the backend's own
# .env (WORLD_ID_APP_ID, WORLD_ID_RP_ID, WORLD_ID_ACTION); this app asks
# /api/worldid/request and never names them. Setting VITE_WORLD_ID_* here has
# no effect at all.

# Polygon Amoy RPC URL.
# NOTE: https://rpc-amoy.polygon.technology no longer resolves (dead since 2026).
# Left empty on Amoy, the client uses TWO free endpoints, because none does both
# jobs (measured 2026-09-28 across every Amoy RPC on chainlist.org):
#   calls  publicnode: takes batches of any size, which ethers sends whenever
#          reads share a tick, but caps eth_getLogs at 10000 blocks.
#   logs   Tenderly: serves eth_getLogs over any range, but answers 429 to a
#          batch of four or more eth_call, and ethers retries a 429 until the
#          page hangs. So only log queries go there (VITE_LOGS_RPC_URL).
# If the log endpoint fails, the query is retried on the call endpoint in
# 10000-block windows: slower, never wrong.
# VITE_RPC_URL is the generic override and wins over VITE_AMOY_RPC_URL.
# A PATH (/rpc) is also accepted and is resolved against this app's origin, which
# the dev server proxies to the local node. Same reason as VITE_BACKEND_URL.
VITE_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
VITE_AMOY_RPC_URL=
VITE_LOGS_RPC_URL=https://polygon-amoy.gateway.tenderly.co

# Target network name (matches the deployment manifest filename). Default: amoy
VITE_CHAIN_NETWORK=amoy
VITE_CHAIN_ID=80002

# ── Gasless voting ──
# Voters never send their own transaction: a per-voter address would link their
# enroll to their ballot on chain. They post to the issuer's relayer instead
# (VITE_BACKEND_URL), which forwards through ElectionPaymaster. Nothing to
# configure here.

# Deployed contract addresses on Amoy.
# NOTE: the deploy script also writes src/lib/deployments/amoy.json, which the
# client reads automatically: these env vars are only needed to override it.
VITE_ELECTION_FACTORY_ADDRESS=
VITE_PLATFORM_REGISTRY_ADDRESS=
VITE_PAYMASTER_ADDRESS=

# Highest tip, in gwei, this page proposes to the organizer's wallet. Amoy's
# fee suggestion follows a few bots at up to 279 gwei; 30 is included just as
# fast. The organizer can still raise it in the wallet. Default 50.
# VITE_MAX_TIP_GWEI=50

# ── Circuits ──
# OVERRIDE ONLY. The proving files (<kind>_s<N>.wasm/.zkey) are outputs of the
# deployment's trusted setup, far too large for the repository.
# `npm run publish:circuits` in circuits/ uploads them and writes their URL into
# the deployment manifest, which is where the app reads it. Unset, and with no
# URL in the manifest (the local chain), the app reads /circuits/, which
# `npm run build` in circuits/ fills.
VITE_CIRCUITS_URL=

# ── Public site URL ──
# The absolute origin this build will be served from, with no trailing slash.
# Production is https://votain.app and lives in .env.production, which is
# committed; set this one only to point a local or preview build somewhere else.
# It fills the canonical link, the Open Graph URLs and the manifest references
# in index.html, and it is what robots.txt and sitemap.xml are generated from
# at build time (see src/seo/seoPlugin.ts). Without it the build warns and
# emits neither file, because a sitemap of relative URLs is rejected outright.
VITE_PUBLIC_URL=https://votain.app

# ── Local chain signers (development only) ──
# The local Hardhat chain has no backend relayer, so the app signs those two
# transactions itself. In `npm run dev` it falls back to Hardhat's well-known
# public accounts and these can stay empty. A PRODUCTION build carries no key at
# all (the fallback is compiled out), so set them only if you deliberately point
# one at a local chain.
VITE_LOCAL_RELAY_KEY=
VITE_LOCAL_REGISTRAR_KEY=

# ── WalletConnect ──
# Lets an organizer connect a wallet that lives in another app, which is the
# only route on a phone: a browser without an extension has no injected
# provider to find. Get one at dashboard.walletconnect.com; it is public by
# design and ships in the client bundle. Leave empty to disable the option.
VITE_WALLETCONNECT_PROJECT_ID=
